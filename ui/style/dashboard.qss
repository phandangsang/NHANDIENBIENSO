QMainWindow,
QWidget {
    background-color: #030a1c;
    color: #ffffff;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
}

QFrame {
    background-color: #051228;
    border: 1px solid #0c264d;
    border-radius: 4px;
}

QFrame QLabel {
    background-color: transparent;
    border: none;
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
}

QLabel {
    color: #ffffff;
    background-color: transparent;
}

QLabel#plate_label {
    background-color: #06152d;
    border: 1px solid #103161;
    border-radius: 4px;
    color: #00e5ff;
    font-size: 28px;
    font-weight: bold;
    padding: 20px;
}

QLabel#time_label {
    background-color: #06152d;
    border: 1px solid #103161;
    border-radius: 4px;
    color: #69f0ae;
    font-size: 20px;
    font-weight: bold;
    padding: 20px;
}

QFrame#info_frame {
    background-color: #051228;
    border: 1px solid #0c264d;
    border-radius: 4px;
    padding: 12px;
}

QComboBox {
    combobox-popup: 0;
    background-color: #06152d;
    border: 1px solid #103161;
    border-radius: 4px;
    color: #ffffff;
    padding: 6px 30px 6px 12px;
    min-width: 120px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #00e5ff;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #06152d;
    border: 1px solid #103161;
    selection-background-color: #0b2752;
    selection-color: #00e5ff;
    color: #ffffff;
    outline: none;
}

QPushButton {
    background-color: #092142;
    color: #00e5ff;
    border: 1px solid #10366b;
    border-radius: 4px;
    padding: 10px 14px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0b2752;
    border-color: #00e5ff;
}

QPushButton:disabled {
    background-color: #071326;
    color: #4f73a5;
    border-color: #0c264d;
}
